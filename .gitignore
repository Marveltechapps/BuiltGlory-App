# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo — local cache, export output, and prebuild artifacts
.expo/
.expo-shared/
.expo-export-check*
dist/
web-build/
expo-env.d.ts

# Native signing and credentials (never commit)
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
logs/
*.log

# OS junk
.DS_Store
Thumbs.db

# dotenv — local secrets, examples, and non-production env
.env
.env.*
*.local

# test / coverage
coverage/

# Non-production — docs, AI assistants, editor config, and API tooling
docs/
load-tests/
AGENTS.md
CLAUDE.md
.cursor/
.claude/
.vscode/
.idea/
postman/
postman-*
*.md
!README.md
!LICENSE

# typescript
*.tsbuildinfo

# generated native folders (use `npx expo prebuild` locally)
/ios
/android
